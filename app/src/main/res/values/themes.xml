<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Helper_application" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dialer_primary</item>
        <item name="colorOnPrimary">@color/dialer_on_primary</item>
        <item name="colorPrimaryContainer">#D6E4FF</item>
        <item name="colorOnPrimaryContainer">#0D2F6E</item>
        <item name="colorSecondary">@color/dialer_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/dialer_tertiary</item>
        <item name="android:colorBackground">@color/dialer_background</item>
        <item name="colorSurface">@color/dialer_surface</item>
        <item name="colorOnSurface">@color/dialer_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/dialer_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/dialer_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/dialer_surface_container_high</item>
        <item name="colorOutline">@color/dialer_outline</item>
        <item name="colorOutlineVariant">@color/dialer_outline_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/dialer_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Helper_application.InCall" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/dialer_on_surface</item>
        <item name="android:colorBackground">@color/dialer_primary_dark</item>
        <item name="colorSurface">@color/dialer_primary_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">#B3C5E8</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/dialer_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Helper_application.Incoming" parent="Theme.Helper_application.InCall" />

    <style name="Widget.Dialer.Key" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/dial_key_size</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">@dimen/dial_key_margin</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">38dp</item>
        <item name="backgroundTint">@color/dialer_surface_container_high</item>
        <item name="rippleColor">@color/dialer_primary</item>
    </style>

    <style name="Widget.Dialer.SearchInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/dialer_outline_variant</item>
        <item name="hintTextColor">@color/dialer_on_surface_variant</item>
    </style>

    <style name="Widget.Dialer.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.Dialer.InCall.Action" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">@dimen/incall_action_size</item>
        <item name="android:layout_height">@dimen/incall_action_size</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cornerRadius">32dp</item>
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="iconGravity">textTop</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Widget.Dialer.InCall.EndCall" parent="Widget.Material3.Button">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="cornerRadius">36dp</item>
        <item name="backgroundTint">@color/dialer_call_red</item>
        <item name="iconTint">@color/white</item>
        <item name="icon">@drawable/ic_call_end</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="TextAppearance.Dialer.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Dialer.Avatar" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
